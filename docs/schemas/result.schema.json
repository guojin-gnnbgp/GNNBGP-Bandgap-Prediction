{
  "$defs": {
    "BackendId": {
      "description": "Stable identifiers for supported scientific backends.",
      "enum": [
        "gnn-hse06",
        "abacus-hse06",
        "abacus-pbe0",
        "cider-pbe0"
      ],
      "title": "BackendId",
      "type": "string"
    },
    "ElectronicClassification": {
      "description": "Occupation-aware interpretation of a numerical gap.",
      "enum": [
        "insulator",
        "zero_gap",
        "partial_occupancy",
        "metal",
        "unknown"
      ],
      "title": "ElectronicClassification",
      "type": "string"
    },
    "GapType": {
      "description": "Whether the gap is direct or indirect, from the bundled classifier.",
      "enum": [
        "direct",
        "indirect"
      ],
      "title": "GapType",
      "type": "string"
    },
    "PredictionValue": {
      "description": "Numerical band gap and its electronic interpretation.",
      "properties": {
        "gap_ev": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Ev"
        },
        "classification": {
          "$ref": "#/$defs/ElectronicClassification",
          "default": "unknown"
        },
        "gap_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/GapType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Type"
        },
        "gap_type_probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Type Probability"
        }
      },
      "title": "PredictionValue",
      "type": "object"
    },
    "RunStatus": {
      "description": "Terminal status of an allocated prediction run.",
      "enum": [
        "success",
        "failed",
        "interrupted"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "description": "Versioned machine-readable result returned by every backend.",
  "properties": {
    "artifact_path": {
      "format": "path",
      "title": "Artifact Path",
      "type": "string"
    },
    "backend": {
      "$ref": "#/$defs/BackendId"
    },
    "converged": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Converged"
    },
    "diagnostics": {
      "additionalProperties": true,
      "title": "Diagnostics",
      "type": "object"
    },
    "elapsed_seconds": {
      "minimum": 0.0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "occupation_summary": {
      "additionalProperties": true,
      "title": "Occupation Summary",
      "type": "object"
    },
    "prediction": {
      "$ref": "#/$defs/PredictionValue"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "structure": {
      "additionalProperties": true,
      "title": "Structure",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "status",
    "backend",
    "method",
    "prediction",
    "converged",
    "structure",
    "started_at",
    "finished_at",
    "elapsed_seconds",
    "artifact_path"
  ],
  "title": "PredictionResult",
  "type": "object"
}
