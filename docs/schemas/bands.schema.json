{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bandgap-predictor.invalid/schemas/bands.schema.json",
  "title": "bands.json",
  "description": "PLANNED CONTRACT, NOT IMPLEMENTED in package 0.1.0. Written by a future 'bgp bands' command; contract frozen in docs/superpowers/specs/2026-10-13-band-structure-design.md and planned in docs/superpowers/plans/2026-10-13-band-structure.md.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "backend",
    "method",
    "mechanism",
    "converged",
    "submitted_structure",
    "band_cell",
    "symmetry",
    "path",
    "frontier",
    "eigenvalues_ev",
    "settings",
    "provenance",
    "warnings",
    "artifact_path"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "status": {"enum": ["success", "failed", "interrupted"]},
    "backend": {"enum": ["abacus-hse06", "abacus-pbe0", "cider-pbe0"]},
    "method": {"type": "string"},
    "mechanism": {
      "enum": ["hybrid_band_targets", "nscf_line"],
      "description": "Measured workflow: K_POINTS_BAND hybrid band targets, or nscf with a line-mode main KPT."
    },
    "converged": {"type": ["boolean", "null"]},
    "submitted_structure": {
      "type": "object",
      "required": ["source_path", "formula", "original_sha256", "structure_sha256"]
    },
    "band_cell": {
      "type": "object",
      "required": ["cell_angstrom", "symbols", "positions_angstrom", "structure_sha256", "source"],
      "properties": {
        "cell_angstrom": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}, "minItems": 3, "maxItems": 3},
        "symbols": {"type": "array", "items": {"type": "string"}},
        "positions_angstrom": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
        "structure_sha256": {"type": "string"},
        "source": {"const": "seekpath_primitive"}
      }
    },
    "symmetry": {
      "type": "object",
      "required": ["seekpath_version", "spglib_version", "spacegroup_number", "spacegroup_international", "bravais_lattice"],
      "properties": {
        "spacegroup_number": {"type": "integer"},
        "spacegroup_international": {"type": "string"},
        "bravais_lattice": {"type": "string"}
      }
    },
    "path": {
      "type": "object",
      "required": ["reference_distance", "labels", "label_positions", "segment_counts", "segment_breaks", "kpoints_direct", "cumulative_distance", "kpoints_cartesian"],
      "properties": {
        "reference_distance": {"type": "number", "exclusiveMinimum": 0},
        "labels": {"type": "array", "items": {"type": "string"}},
        "label_positions": {"type": "array", "items": {"type": "number"}},
        "segment_counts": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "segment_breaks": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "kpoints_direct": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}},
        "cumulative_distance": {"type": "array", "items": {"type": "number"}, "description": "Angstrom^-1 (2*pi convention), resetting at each path piece."},
        "kpoints_cartesian": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}}
      }
    },
    "fermi_energy_ev": {"type": ["number", "null"]},
    "frontier": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["vbm_ev", "cbm_ev", "gap_ev", "gap_kind", "classification"],
          "properties": {
            "vbm_ev": {"type": "number"},
            "cbm_ev": {"type": "number"},
            "gap_ev": {"type": "number", "minimum": 0},
            "gap_kind": {"enum": ["direct", "indirect"]},
            "classification": {"enum": ["insulator", "zero_gap", "partial_occupancy", "metal", "unknown"]},
            "vbm_kpoint": {"type": "array", "items": {"type": "number"}},
            "cbm_kpoint": {"type": "array", "items": {"type": "number"}},
            "vbm_label": {"type": ["string", "null"]},
            "cbm_label": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "eigenvalues_ev": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
    "occupations": {"type": ["array", "null"], "items": {"type": "array", "items": {"type": "number"}}},
    "scf": {"type": ["object", "null"], "description": "Stage-1 result.json payload and its gap."},
    "settings": {"type": "object"},
    "provenance": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error_message": {"type": ["string", "null"]},
    "artifact_path": {"type": "string"}
  }
}
